# Environment variables — copy to .env and fill in your values
# NEVER commit .env to git

# Web3Forms access key — get yours at https://web3forms.com
VITE_WEB3FORMS_KEY=

# Spline scene URL — from your Spline scene's "Publish" panel
# Leave blank to show the static poster only (site works without this)
VITE_SPLINE_SCENE_URL=https://prod.spline.design/b4i9OHkvVqcth-u6/scene.splinecode